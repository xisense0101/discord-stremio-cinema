FROM node:22-bookworm-slim AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    python3 \
    ffmpeg \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@9

COPY package.json pnpm-workspace.yaml tsconfig.json .npmrc ./
COPY packages/ ./packages/
COPY apps/stream-worker/ ./apps/stream-worker/
COPY apps/web/ ./apps/web/

RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter "./packages/**" --filter "@discord-stremio/stream-worker" run build

FROM node:22-bookworm-slim AS runner
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    ca-certificates \
    curl \
    fonts-liberation \
    fonts-noto-cjk \
    fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@9

COPY --from=builder /app ./

ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=1536"
ENV PORT=4001
ENV WORKER_PORT=4001

EXPOSE 4001

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://127.0.0.1:4001/health || exit 1

CMD ["pnpm", "--filter", "@discord-stremio/stream-worker", "start"]
