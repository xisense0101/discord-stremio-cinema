# ==========================================
# Discord Stremio Player Configuration
# ==========================================

# Discord Controller Bot Token (discord.js v14)
DISCORD_CONTROLLER_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_bot_client_id_here

# Discord Stream Worker User Token (Go-Live / Voice Gateway)
DISCORD_STREAMER_TOKEN=your_user_token_here

# TorBox Configuration
TORBOX_API_KEY=your_torbox_api_key_here
RESOLVER_MODE=torbox-direct # Options: torbox-direct | aiostreams

# AIOStreams Configuration (Optional - Mode B)
AIOSTREAMS_URL=http://localhost:3000

# Redis Connection (Playback state, locks & IPC)
REDIS_URL=redis://localhost:6379

# PostgreSQL Connection (Persistent queue & settings)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_stremio

# Stream Encoding & Quality Settings
STREAM_WIDTH=1920
STREAM_HEIGHT=1080
STREAM_FPS=30
STREAM_BITRATE_KBPS=6000
STREAM_MAX_BITRATE_KBPS=8000
STREAM_AUDIO_BITRATE_KBPS=128

# Browser Configuration
PUPPETEER_HEADLESS=true
CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome

# Server & Health
PORT=4000
WORKER_PORT=4001
NODE_ENV=production
