# ====================================================
# Discord Stremio Player & Web Controller Configuration
# ====================================================

# Discord Controller Bot Token (discord.js v14)
DISCORD_CONTROLLER_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_bot_client_id_here

# Discord Streamer User Account Token (Go-Live WebRTC Voice Gateway)
DISCORD_STREAMER_TOKEN=your_discord_user_account_token_here

# TorBox Debrid API Key (https://torbox.app)
TORBOX_API_KEY=your_torbox_api_key_here
RESOLVER_MODE=torbox-direct

# Web Authentication & JWT Secret (Next.js Dashboard)
JWT_SECRET=generate_a_secure_random_string_for_production
WEB_USERNAME=senzu
WEB_PASSWORD=herewegoagain

# Redis & Storage (Optional: in-memory fallback enabled by default)
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=sqlite://./data/stremio_player.db

# Target Discord Server & Voice Channel Defaults
DEFAULT_GUILD_ID=your_target_discord_server_guild_id_here
DEFAULT_VOICE_CHANNEL_ID=your_target_voice_channel_id_here

# Stream Encoding & Bitrate Settings
STREAM_WIDTH=1920
STREAM_HEIGHT=1080
STREAM_FPS=30
STREAM_BITRATE_KBPS=6000
STREAM_MAX_BITRATE_KBPS=8000
STREAM_AUDIO_BITRATE_KBPS=128

# Server Ports
PORT=4000
WORKER_PORT=4001
WORKER_URL=http://localhost:4001
NODE_ENV=development
