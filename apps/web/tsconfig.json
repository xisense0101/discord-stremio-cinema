{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@discord-stremio/config": ["../../packages/config/src/index.ts"],
      "@discord-stremio/metadata": ["../../packages/metadata/src/index.ts"],
      "@discord-stremio/playback": ["../../packages/playback/src/index.ts"],
      "@discord-stremio/queue": ["../../packages/queue/src/index.ts"],
      "@discord-stremio/sessions": ["../../packages/sessions/src/index.ts"],
      "@discord-stremio/diagnostics": ["../../packages/diagnostics/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "../../packages/**/*.ts"],
  "exclude": ["node_modules"]
}
